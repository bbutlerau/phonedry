{{!--
  The stats screen: abilities, saves and skills, all of them rollable.

  Every rollable control carries `data-roll` (what kind) and `data-roll-key`
  (which one). The shell reads those in one place rather than binding a handler
  per row, so adding a roll type is a template change plus one case in the
  dispatcher. Whether it rolls straight, with advantage or with disadvantage
  comes from the selector in the header, not from the control itself.

  A tab body, included by content.hbs. It has no wrapper of its own and no
  single-root constraint — that belongs to the part, which is content.hbs.
--}}
{{#if stats}}

  {{#if stats.deathSaves}}
    {{!-- Placed above everything else, because when it is showing at all it
          is the only thing that matters. --}}
    <section class="phonedry-death">
      <h2 class="phonedry-section__heading">{{localize "PHONEDRY.Sheet.DeathSaves"}}</h2>
      <div class="phonedry-death__pips">
        <span class="phonedry-death__label">{{localize "PHONEDRY.Sheet.Successes"}}</span>
        {{#each stats.deathSaves.successes}}
          <span class="phonedry-pip phonedry-pip--success{{#if this}} phonedry-pip--filled{{/if}}"></span>
        {{/each}}
      </div>
      <div class="phonedry-death__pips">
        <span class="phonedry-death__label">{{localize "PHONEDRY.Sheet.Failures"}}</span>
        {{#each stats.deathSaves.failures}}
          <span class="phonedry-pip phonedry-pip--failure{{#if this}} phonedry-pip--filled{{/if}}"></span>
        {{/each}}
      </div>
      <button type="button" class="phonedry-death__roll" data-action="roll" data-roll="death">
        {{localize "PHONEDRY.Sheet.RollDeathSave"}}
      </button>
    </section>
  {{/if}}

  <section class="phonedry-section">
    <h2 class="phonedry-section__heading">{{localize "PHONEDRY.Sheet.Abilities"}}</h2>

    {{!-- Each ability is two separate targets, check and save, because they
          are different rolls and a phone has no right-click to tell them
          apart. The score sits between them as a label, not a control. --}}
    <ul class="phonedry-abilities">
      {{#each stats.abilities}}
        <li class="phonedry-ability">
          <span class="phonedry-ability__label">{{this.abbreviation}}</span>
          <span class="phonedry-ability__score">{{this.score}}</span>

          <button type="button" class="phonedry-ability__check" data-action="roll" data-roll="check"
                  data-roll-key="{{this.key}}"
                  aria-label="{{localize 'PHONEDRY.Sheet.CheckAria' ability=this.label}}">
            {{this.mod}}
          </button>

          <button type="button" class="phonedry-ability__save phonedry-prof--{{this.saveProficiency}}"
                  data-action="roll" data-roll="save" data-roll-key="{{this.key}}"
                  aria-label="{{localize 'PHONEDRY.Sheet.SaveAria' ability=this.label}}">
            <span class="phonedry-ability__save-term">{{localize "PHONEDRY.Sheet.SaveShort"}}</span>
            {{this.save}}
          </button>
        </li>
      {{/each}}
    </ul>
  </section>

  <section class="phonedry-section">
    <h2 class="phonedry-section__heading">{{localize "PHONEDRY.Sheet.Skills"}}</h2>

    <ul class="phonedry-skills">
      {{#each stats.skills}}
        <li>
          {{!-- Holding a skill shows the rule it covers. The attribute is
                omitted rather than left empty where there is no reference to
                point at: an empty one still matches the gesture's selector, and
                a hold that resolves to nothing would swallow the tap that
                follows it and stop the skill rolling. --}}
          <button type="button" class="phonedry-skill" data-action="roll" data-roll="skill"
                  data-roll-key="{{this.key}}"
                  {{#if this.reference}}data-describe-uuid="{{this.reference}}"{{/if}}>
            <span class="phonedry-pip phonedry-prof--{{this.proficiency}}"></span>
            <span class="phonedry-skill__name">{{this.label}}</span>
            <span class="phonedry-skill__ability">{{this.abilityLabel}}</span>
            <span class="phonedry-skill__mod">{{this.total}}</span>
            <span class="phonedry-skill__passive">{{this.passive}}</span>
          </button>
        </li>
      {{/each}}
    </ul>

    {{!-- Said in words because a hold is invisible until someone tries it. --}}
    <p class="phonedry-section__note">{{localize "PHONEDRY.Describe.HintSkills"}}</p>
  </section>

  {{!-- Tools sit under skills because they are the same gesture on the same
        kind of thing: a d20 against an ability, rolled the same way and read
        the same way. Keeping them apart from the skills list rather than mixed
        into it is what stops "Calligrapher's Supplies" appearing between
        Athletics and Deception, where nobody is looking for it.

        Only the tools the character is trained in. dnd5e knows about forty and
        a character has one or two, so listing the rest would bury the ones that
        matter under a screen of zeroes. That is the opposite of the rule above,
        where every skill is rollable whether proficient or not — and right for
        the opposite reason: an untrained skill check is ordinary, an untrained
        tool check is the GM saying you may try anyway. --}}
  {{#if stats.tools.length}}
    <section class="phonedry-section">
      <h2 class="phonedry-section__heading">{{localize "PHONEDRY.Sheet.Tools"}}</h2>

      <ul class="phonedry-tools">
        {{#each stats.tools}}
          <li>
            <button type="button" class="phonedry-skill" data-action="roll" data-roll="tool"
                    data-roll-key="{{this.key}}">
              <span class="phonedry-pip phonedry-prof--{{this.proficiency}}"></span>
              <span class="phonedry-skill__name">{{this.label}}</span>
              <span class="phonedry-skill__ability">{{this.abilityLabel}}</span>
              <span class="phonedry-skill__mod">{{this.total}}</span>
              {{!-- The column is held open rather than dropped, so the
                    modifiers line up with the skills directly above. A tool has
                    no passive score — passive perception is a skill idea. --}}
              <span class="phonedry-skill__passive"></span>
            </button>
          </li>
        {{/each}}
      </ul>
    </section>
  {{/if}}

{{else}}

  {{!-- No character to show. Each reason gets its own wording, because
        "nobody assigned you one" and "you own several, pick one" call for
        completely different things from the player. --}}
  <section class="phonedry-empty">
    <h2>{{localize "PHONEDRY.Empty.Heading"}}</h2>

    {{#if (eq empty.reason "ambiguous")}}
      <p>{{localize "PHONEDRY.Empty.Ambiguous"}}</p>
      <ul class="phonedry-empty__candidates">
        {{#each empty.candidates}}<li>{{this.name}}</li>{{/each}}
      </ul>
    {{else}}
      <p>{{localize "PHONEDRY.Empty.None" user=empty.userName}}</p>
    {{/if}}

    <p class="phonedry-empty__escape">
      <a href="?phonedry=off">{{localize "PHONEDRY.Empty.Escape"}}</a>
    </p>
  </section>

{{/if}}
