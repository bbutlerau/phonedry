{{!--
  The persistent header: who this is, and the numbers a player checks
  constantly enough that they must never be behind a scroll.

  CONSTRAINT: this template must render EXACTLY ONE top-level element. Core's
  #parsePartHTML throws otherwise, and because Phonedry has already disabled the
  canvas by the time a part renders, that throw presents as a blank screen with
  no visible error rather than as an exception anyone will see.
--}}
<header class="phonedry-header">

  {{#if stats}}
    <div class="phonedry-header__identity">
      {{#if stats.header.img}}
        <img class="phonedry-header__portrait" src="{{stats.header.img}}" alt="" />
      {{/if}}
      <div class="phonedry-header__names">
        <h1 class="phonedry-header__name">{{stats.header.name}}</h1>
        <p class="phonedry-header__subtitle">
          {{#if stats.header.race}}{{stats.header.race}}{{/if}}
          {{#if stats.header.classes}}{{stats.header.classes}}{{/if}}
        </p>
      </div>

      {{!-- The only way out. Suppressing the sidebar takes Foundry's own logout
            with it, so without this a player on a phone cannot change user
            without clearing site data. --}}
      <button type="button" class="phonedry-header__logout" data-action="logOut"
              aria-label="{{localize 'PHONEDRY.LogOut'}}">
        <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
      </button>
    </div>

    {{!-- Hit points get the full width and a bar: it is the only number here
          that changes every round, and the one people read at a glance.

          The whole bar is the button that opens the editor. Tapping the number
          you want to change is the obvious gesture, and it gives the largest
          target on the sheet to the thing reached for most often mid-fight.
          Spans throughout, because a <button> may not contain a <div>. --}}
    <button type="button"
            class="phonedry-hp {{#if stats.header.hp.unconscious}}phonedry-hp--down{{else if stats.header.hp.bloodied}}phonedry-hp--bloodied{{/if}}"
            data-action="toggleHpEditor" aria-expanded="false" aria-controls="phonedry-hp-editor">
      <span class="phonedry-hp__bar" style="--phonedry-hp-pct: {{stats.header.hp.pct}}%"></span>
      <span class="phonedry-hp__text">
        <span class="phonedry-hp__label">{{localize "PHONEDRY.Sheet.HitPoints"}}</span>
        <span class="phonedry-hp__value">
          {{stats.header.hp.value}}<span class="phonedry-hp__sep">/</span>{{stats.header.hp.max}}
          {{#if stats.header.hp.temp}}<span class="phonedry-hp__temp">+{{stats.header.hp.temp}}</span>{{/if}}
        </span>
      </span>
    </button>

    {{!-- Hidden until the bar is tapped. The `hidden` attribute rather than a
          class, so it is inert to assistive technology as well as invisible. --}}
    <div class="phonedry-hp-editor" id="phonedry-hp-editor" hidden>
      <div class="phonedry-hp-editor__amount">
        <button type="button" class="phonedry-hp-editor__step"
                data-action="stepHp" data-step="-1"
                aria-label="{{localize 'PHONEDRY.HitPoints.Decrease'}}">&minus;</button>

        {{!-- `inputmode` rather than `type="number"`: it raises the numeric
              keypad on both platforms without the spinner arrows, which are
              mouse furniture and shrink the field on a narrow screen. --}}
        <input type="text" inputmode="numeric" pattern="[0-9]*"
               class="phonedry-hp-editor__input" name="hpAmount"
               placeholder="0" autocomplete="off"
               aria-label="{{localize 'PHONEDRY.HitPoints.Amount'}}" />

        <button type="button" class="phonedry-hp-editor__step"
                data-action="stepHp" data-step="1"
                aria-label="{{localize 'PHONEDRY.HitPoints.Increase'}}">+</button>
      </div>

      {{!-- Direction is the button, not a sign on the number. "Damage 5" and
            "Heal 5" cannot be confused the way "-5" and "5" can. --}}
      <div class="phonedry-hp-editor__actions">
        <button type="button" class="phonedry-hp-editor__action phonedry-hp-editor__action--damage"
                data-action="applyHp" data-hp="damage">{{localize "PHONEDRY.HitPoints.Damage"}}</button>
        <button type="button" class="phonedry-hp-editor__action phonedry-hp-editor__action--heal"
                data-action="applyHp" data-hp="heal">{{localize "PHONEDRY.HitPoints.Heal"}}</button>
        <button type="button" class="phonedry-hp-editor__action"
                data-action="applyHp" data-hp="temp">{{localize "PHONEDRY.HitPoints.Temp"}}</button>
      </div>
    </div>

    {{!-- Divs rather than a definition list, because one of these is a button
          and <dl> permits only dt, dd and div as children. --}}
    <div class="phonedry-vitals">
      <div class="phonedry-vitals__item">
        <span class="phonedry-vitals__term">{{localize "PHONEDRY.Sheet.ArmourClass"}}</span>
        <span class="phonedry-vitals__value">{{stats.header.ac}}</span>
      </div>

      <button type="button" class="phonedry-vitals__item phonedry-vitals__item--action"
              data-action="rollInitiative">
        <span class="phonedry-vitals__term">{{localize "PHONEDRY.Sheet.Initiative"}}</span>
        <span class="phonedry-vitals__value">{{stats.header.initiative}}</span>
      </button>

      <div class="phonedry-vitals__item">
        <span class="phonedry-vitals__term">{{localize "PHONEDRY.Sheet.Speed"}}</span>
        <span class="phonedry-vitals__value">{{stats.header.speed}}<span class="phonedry-vitals__unit">{{stats.header.speedUnits}}</span></span>
      </div>

      <div class="phonedry-vitals__item">
        <span class="phonedry-vitals__term">{{localize "PHONEDRY.Sheet.Proficiency"}}</span>
        <span class="phonedry-vitals__value">{{stats.header.proficiency}}</span>
      </div>

      {{#if stats.header.spellDc}}
        <div class="phonedry-vitals__item">
          <span class="phonedry-vitals__term">{{localize "PHONEDRY.Sheet.SpellSave"}}</span>
          <span class="phonedry-vitals__value">{{stats.header.spellDc}}</span>
        </div>
      {{/if}}

      {{#if stats.header.exhaustion}}
        <div class="phonedry-vitals__item phonedry-vitals__item--warning">
          <span class="phonedry-vitals__term">{{localize "PHONEDRY.Sheet.Exhaustion"}}</span>
          <span class="phonedry-vitals__value">{{stats.header.exhaustion}}</span>
        </div>
      {{/if}}
    </div>

    {{!--
      How the next roll is made. A visible control rather than a gesture: a
      hold is unmarked and undiscoverable, and this is a setting a player needs
      to see the state of without touching anything. Holding is used elsewhere
      on the sheet, but only for inspecting.

      It is sticky, so advantage granted for a whole fight is set once. The
      shell mirrors the value onto the root element, which is what lets the
      stylesheet tint every roll control at once while it is not normal.
    --}}
    <div class="phonedry-mode" role="group" aria-label="{{localize 'PHONEDRY.Rolls.ModeLabel'}}">
      <button type="button" class="phonedry-mode__option phonedry-mode__option--advantage"
              data-action="setRollMode" data-mode="advantage" aria-pressed="false">
        {{localize "PHONEDRY.Rolls.Advantage"}}
      </button>
      <button type="button" class="phonedry-mode__option"
              data-action="setRollMode" data-mode="normal" aria-pressed="true">
        {{localize "PHONEDRY.Rolls.Normal"}}
      </button>
      <button type="button" class="phonedry-mode__option phonedry-mode__option--disadvantage"
              data-action="setRollMode" data-mode="disadvantage" aria-pressed="false">
        {{localize "PHONEDRY.Rolls.Disadvantage"}}
      </button>
    </div>
  {{else}}
    <h1 class="phonedry-header__name">{{localize "PHONEDRY.Title"}}</h1>
  {{/if}}

</header>
