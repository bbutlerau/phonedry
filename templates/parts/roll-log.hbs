{{!--
  The roll log: what was just rolled, and what came before it.

  Sits at the bottom of the screen, which is where a thumb is. The bar is
  always present, even before anything has been rolled: it is the only route to
  the formula field, and hiding it until a first roll meant a player could not
  type a roll until they had made one some other way.

  CONSTRAINT: exactly one top-level element. See the note in header.hbs.
--}}
<div class="phonedry-log">

  {{!-- The history, above the bar and hidden until asked for. Newest first. --}}
  <ul class="phonedry-log__history" id="phonedry-log-history" {{#unless rollLogOpen}}hidden{{/unless}}>
    {{#each rollLog}}
      <li class="phonedry-log__entry">
        <span class="phonedry-log__flavor">{{this.flavor}}</span>
        <span class="phonedry-log__dice">
          {{#each this.dice}}
            <span class="phonedry-log__die
                        {{#if this.dropped}}phonedry-log__die--dropped{{/if}}
                        {{#if this.natural20}}phonedry-log__die--max{{/if}}
                        {{#if this.natural1}}phonedry-log__die--min{{/if}}">{{this.value}}</span>
          {{/each}}
          {{#if this.moreDice}}<span class="phonedry-log__more">+{{this.moreDice}}</span>{{/if}}
        </span>
        <span class="phonedry-log__total
                     {{#if this.critical}}phonedry-log__total--critical{{/if}}
                     {{#if this.fumble}}phonedry-log__total--fumble{{/if}}">{{this.total}}</span>
      </li>
    {{/each}}
  </ul>

  {{!--
    Type a roll, like Foundry's /r. Shown with the history rather than always,
    because it is occasional — damage the sheet does not know about yet, a
    death save the GM asked for, a d100. Sits directly above the bar so it is
    the nearest thing to the thumb once opened.
  --}}
  {{#if rollLogOpen}}
    <div class="phonedry-log__formula">
      <input type="text" class="phonedry-log__formula-input" name="formula"
             value="{{formula}}" placeholder="{{localize 'PHONEDRY.Rolls.FormulaPlaceholder'}}"
             autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"
             aria-label="{{localize 'PHONEDRY.Rolls.FormulaLabel'}}" />
      <button type="button" class="phonedry-log__formula-roll" data-action="rollTyped">
        {{localize "PHONEDRY.Rolls.Roll"}}
      </button>
    </div>
  {{/if}}

  {{!--
    The bar: the most recent roll while collapsed, and a plain heading once the
    history is open — the list already starts with that roll, and showing it
    twice reads as a bug rather than as a summary.
  --}}
  <button type="button" class="phonedry-log__latest" data-action="toggleRollLog"
          aria-expanded="{{#if rollLogOpen}}true{{else}}false{{/if}}"
          aria-controls="phonedry-log-history">
    {{#if rollLogOpen}}
      <span class="phonedry-log__flavor">{{localize "PHONEDRY.Rolls.Recent"}}</span>
    {{else if rollLog.length}}
      {{#with rollLog.[0]}}
        <span class="phonedry-log__flavor">{{this.flavor}}</span>
        <span class="phonedry-log__dice">
          {{#each this.dice}}
            <span class="phonedry-log__die
                        {{#if this.dropped}}phonedry-log__die--dropped{{/if}}
                        {{#if this.natural20}}phonedry-log__die--max{{/if}}
                        {{#if this.natural1}}phonedry-log__die--min{{/if}}">{{this.value}}</span>
          {{/each}}
          {{#if this.moreDice}}<span class="phonedry-log__more">+{{this.moreDice}}</span>{{/if}}
        </span>
        <span class="phonedry-log__total
                     {{#if this.critical}}phonedry-log__total--critical{{/if}}
                     {{#if this.fumble}}phonedry-log__total--fumble{{/if}}">{{this.total}}</span>
      {{/with}}
    {{else}}
      {{!-- Nothing rolled yet. The bar still shows, because it is the only way
            to reach the formula field — hiding it until a first roll made
            typing a roll impossible until you had rolled something else. --}}
      <span class="phonedry-log__flavor">{{localize "PHONEDRY.Rolls.Empty"}}</span>
    {{/if}}
  </button>

</div>
