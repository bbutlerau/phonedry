{
  "id": "phonedry",
  "title": "Phonedry",
  "description": "A lightweight, canvas-free character sheet client for Foundry VTT on phones and tablets. Players connect to a single full-screen dnd5e sheet instead of the full tabletop client, so the scene canvas never initialises and mobile memory limits stop being the binding constraint.",
  "version": "0.1.0",
  "authors": [
    {
      "name": "Brad Butler",
      "url": "https://github.com/bbutlerau"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.0.0"
        }
      }
    ]
  },
  "esmodules": ["scripts/phonedry.mjs"],
  "styles": ["styles/phonedry.css"],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "url": "https://github.com/bbutlerau/phonedry",
  "manifest": "https://github.com/bbutlerau/phonedry/releases/latest/download/module.json",
  "download": "https://github.com/bbutlerau/phonedry/releases/latest/download/phonedry.zip",
  "readme": "https://github.com/bbutlerau/phonedry/blob/main/README.md",
  "changelog": "https://github.com/bbutlerau/phonedry/blob/main/CHANGELOG.md",
  "bugs": "https://github.com/bbutlerau/phonedry/issues",
  "license": "LICENSE",
  "socket": false,
  "flags": {
    "hotReload": true
  }
}
