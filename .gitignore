# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Node tooling (tests only — the module itself ships unbundled)
node_modules/
npm-debug.log*
coverage/

# Playwright output: traces, screenshots and run state from the smoke tests
test-results/
playwright-report/
.playwright/

# Build output from the release workflow
dist/
*.zip

# Environment / secrets. Phonedry needs none of these, but the rule costs
# nothing and stops an accidental commit if that ever changes.
.env
.env.*
!.env.example
*.key
secrets/

# Session handover notes. Local working state — what was done last, what is
# next, and what to check on a device. Deliberately untracked: it is a running
# scratchpad between sessions rather than documentation of the module, and it
# would be noise in a public repository.
session.md
