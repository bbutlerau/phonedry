# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Node tooling (tests only — the module itself ships unbundled)
node_modules/
npm-debug.log*
coverage/

# Build output from the release workflow
dist/
*.zip

# Environment / secrets. Phonedry needs none of these, but the rule costs
# nothing and stops an accidental commit if that ever changes.
.env
.env.*
!.env.example
*.key
secrets/
